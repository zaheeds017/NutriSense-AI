{
  "name": "nutrition-scanner-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "NutriSense_AI - packaged food nutrition scanner with health scoring, barcode & text analysis",
  "author": "Zaheed",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "app": "concurrently -k \"vite preview --port 4173 --strictPort\" \"wait-on http://localhost:4173 && electron .\"",
    "app:build": "npm run build && electron-builder --win nsis portable",
    "app:dir": "npm run build && electron-builder --dir"
  },
  "dependencies": {
    "@zxing/browser": "^0.2.1",
    "@zxing/library": "^0.23.0",
    "canvas-confetti": "^1.9.4",
    "html5-qrcode": "^2.3.8",
    "lucide-react": "^1.31.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "concurrently": "^9.1.2",
    "electron": "^37.0.0",
    "electron-builder": "^26.0.12",
    "oxlint": "^1.75.0",
    "tailwindcss": "^4.3.3",
    "vite": "^8.2.0",
    "wait-on": "^8.0.3"
  },
  "build": {
    "appId": "com.nutrisense.ai",
    "productName": "NutriSense_AI",
    "files": [
      "dist/**",
      "electron/**"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "NutriSense_AI"
    }
  },
  "allowScripts": {
    "electron@37.10.3": true,
    "tesseract.js@7.0.0": true,
    "electron-winstaller@5.4.0": true
  }
}
